# Neon Postgres (pooled für Runtime, direct für Migrations)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/freiraum?sslmode=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/freiraum?sslmode=require"

# NextAuth
AUTH_SECRET="openssl rand -base64 32"
# Basis-URL für Links in E-Mails (Produktion: https://freiraum.example.de)
AUTH_URL="http://localhost:3000"

# Resend — ohne Key werden Mails nur ins Log geschrieben
RESEND_API_KEY=""
EMAIL_FROM="Freiraum <apps@alw-mediaworks.de>"

# Vercel Blob (Phase 2+: Floorplan-Uploads, Phase 3: Verträge/Signaturen)
BLOB_READ_WRITE_TOKEN=""

# Schutz der Cron-Route
CRON_SECRET=""

# Initialer Admin (nur prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.de"
SEED_ADMIN_PASSWORD="change-me"
